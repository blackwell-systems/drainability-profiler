# Build Redis with libdrainprof instrumentation
#
# This Dockerfile:
# 1. Builds libdrainprof from source
# 2. Clones Redis 7.2
# 3. Applies zmalloc instrumentation patch
# 4. Rebuilds Redis with libdrainprof linked
#
# Usage:
#   docker build -f Dockerfile.redis-instrumented -t redis-drainprof .
#   docker run --rm redis-drainprof redis-server --save "" --appendonly no

FROM debian:bookworm-slim AS drainprof-builder

RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Build libdrainprof
WORKDIR /build
COPY ../../include/drainprof.h ./include/
COPY ../../src/ ./src/
COPY ../../Makefile .

RUN make clean && make
RUN ls -lh libdrainprof.a

# ============================================
# Redis builder stage
# ============================================
FROM debian:bookworm-slim AS redis-builder

RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone Redis 7.2 (stable branch with jemalloc)
WORKDIR /build
RUN git clone --branch 7.2 --depth 1 https://github.com/redis/redis.git

# Copy libdrainprof artifacts
COPY --from=drainprof-builder /build/libdrainprof.a /usr/local/lib/
COPY --from=drainprof-builder /build/include/drainprof.h /usr/local/include/

# Apply instrumentation patch
WORKDIR /build/redis
COPY patches/zmalloc-size-class.patch /tmp/
# TODO: Apply patch when it exists
# RUN patch -p1 < /tmp/zmalloc-size-class.patch

# Build Redis with instrumentation
# Note: Once patch is applied, this will link libdrainprof
RUN make BUILD_TLS=yes \
    # TODO: Add LDFLAGS when patch exists
    # LDFLAGS="-L/usr/local/lib -ldrainprof -lpthread" \
    # CFLAGS="-I/usr/local/include -DENABLE_DRAINPROF"

# ============================================
# Final runtime image
# ============================================
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    redis-tools \
    bc \
    && rm -rf /var/lib/apt/lists/*

# Copy Redis binaries
COPY --from=redis-builder /build/redis/src/redis-server /usr/local/bin/
COPY --from=redis-builder /build/redis/src/redis-cli /usr/local/bin/

# Copy test workloads
COPY workloads/ /workloads/
RUN chmod +x /workloads/*.sh

# Default: Run Redis server
CMD ["redis-server", "--save", "", "--appendonly", "no", "--protected-mode", "no"]

# Note: This Dockerfile is a template. Uncomment patch application
# once patches/zmalloc-size-class.patch is implemented.
