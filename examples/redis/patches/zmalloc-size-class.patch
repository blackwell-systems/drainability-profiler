# Instrumentation patch for Redis zmalloc.c
#
# This patch adds libdrainprof instrumentation to Redis's memory allocation
# wrapper layer. Allocations are grouped by size class:
#
#   Granule 0: size < 256B       (small - strings, list nodes)
#   Granule 1: 256B ≤ size < 1KB (medium)
#   Granule 2: 1KB ≤ size < 4KB  (large)
#   Granule 3: size ≥ 4KB        (huge)
#
# Drainability per size class shows which object sizes cause fragmentation.
#
# Implementation strategy:
#
# 1. Add global drainprof instance in zmalloc.c:
#    static drainprof *g_prof = NULL;
#
# 2. Initialize in zmalloc_init() or first allocation:
#    g_prof = drainprof_create();
#    drainprof_granule_open(g_prof, 0);  // Open all size classes
#    drainprof_granule_open(g_prof, 1);
#    drainprof_granule_open(g_prof, 2);
#    drainprof_granule_open(g_prof, 3);
#
# 3. Instrument zmalloc() / zcalloc():
#    void *zmalloc(size_t size) {
#        void *ptr = je_malloc(size);
#        if (ptr && g_prof) {
#            uint64_t granule_id = size_to_granule(size);
#            drainprof_alloc_register(g_prof, granule_id, (uint64_t)ptr, size);
#        }
#        return ptr;
#    }
#
# 4. Instrument zfree():
#    void zfree(void *ptr) {
#        if (ptr && g_prof) {
#            size_t size = je_sallocx(ptr, 0);  // Query jemalloc for size
#            uint64_t granule_id = size_to_granule(size);
#            drainprof_alloc_deregister(g_prof, granule_id, (uint64_t)ptr);
#        }
#        je_free(ptr);
#    }
