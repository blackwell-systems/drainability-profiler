     int flags) JEMALLOC_ATTR(pure);
 JEMALLOC_EXPORT void JEMALLOC_NOTHROW je_dallocx(void *ptr, int flags);
 JEMALLOC_EXPORT void JEMALLOC_NOTHROW je_sdallocx(void *ptr, size_t size,
     int flags);
 JEMALLOC_EXPORT size_t JEMALLOC_NOTHROW je_nallocx(size_t size, int flags)
     JEMALLOC_ATTR(malloc);
+
+#ifdef ENABLE_DRAINPROF
+/* libdrainprof API for Redis INFO command */
+JEMALLOC_EXPORT double JEMALLOC_NOTHROW jemalloc_get_drainprof_dsr(void);
+JEMALLOC_EXPORT void JEMALLOC_NOTHROW jemalloc_get_drainprof_stats(
+    uint64_t *total_closes, uint64_t *drainable_closes, uint64_t *pinned_closes);
+#endif
